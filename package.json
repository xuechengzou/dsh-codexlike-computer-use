{
  "name": "dsh-computer-use",
  "version": "0.1.0",
  "description": "Computer use for DSH: read the Windows desktop (screenshots + accessibility tree) and act on it through window-targeted or foreground input, with a switchable mode.",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": {
      "default": "./client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "client.js"
  ],
  "engines": {
    "node": ">=20"
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "prepare": "node scripts/build.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "doubles:link": "node scripts/link-doubles.mjs",
    "doubles:unlink": "node scripts/link-doubles.mjs --remove",
    "verify:host": "node scripts/verify-host-contracts.mjs <宿主 node_modules 根>",
    "verify:integration": "node scripts/verify-integration.mjs <宿主 node_modules 根>",
    "verify:cursor": "node scripts/verify-cursor.mjs",
    "install:local": "node scripts/build.mjs && node scripts/install-local.mjs",
    "test": "node scripts/link-doubles.mjs && node scripts/build.mjs && node --test test/*.test.mjs",
    "test:live": "node scripts/link-doubles.mjs && node scripts/build.mjs && node --test --test-name-pattern=. test/live.test.mjs",
    "verify": "node scripts/link-doubles.mjs && node scripts/typecheck.mjs && node scripts/build.mjs && node --test test/*.test.mjs"
  },
  "dependencies": {
    "koffi": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-attachment": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-attachment": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "cordis",
    "computer-use",
    "gui-automation",
    "win32",
    "koffi"
  ]
}
